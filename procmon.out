=== Процессы: эффективный UID = root, реальный UID — обычный пользователь ===
EUSER    RUSER        PID COMMAND
root     Dima        1577 fusermount3 -o rw,nosuid,nodev,fsname=portal,auto_unmount,subtype=portal -- /run/user/1000/doc
root     Dima       54123 su - user1
root     user1      54223 passwd
=== passwd во время работы: euser=root, ruser=user1 ===
root     user1      54223 passwd
