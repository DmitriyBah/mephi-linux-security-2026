   38  {   echo "=== Процессы: эффективный UID = root, реальный UID — обычный пользователь ===";   ps -eo euser,ruser,pid,args | head -1;   ps -eo euser,ruser,pid,args | awk '$1=="root" && $2!="root"';   echo "=== passwd во время работы: euser=root, ruser=user1 ===";   ps -eo euser,ruser,pid,args | grep [p]asswd; } > ~/mephi-repo/procmon.out
   39  echo "=== Процессы: эффективный UID = root, реальный UID — обычный пользователь ==="
