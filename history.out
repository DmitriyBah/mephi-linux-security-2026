   45  { echo "=== Процессы: эффективный UID = root, реальный UID — обычный пользователь ==="; ps -eo euser,ruser,pid,args | head -1; ps -eo euser,ruser,pid,args | awk '$1=="root" && $2!="root"'; echo "=== passwd во время работы: euser=root, ruser=user1 ==="; ps -eo euser,ruser,pid,args | grep [p]asswd; } > ~/mephi-repo/procmon.out
   46  cat ~/mephi-repo/procmon.out
   47  su - user1
   48  echo "demo" | sudo tee /tmp/rootfile > /dev/null
   49  sudo chown root:root /tmp/rootfile
   50  sudo rm -f /home/user1/bin/chown
   51  sudo cp /usr/bin/chown /home/user1/bin/chown
   52  sudo chown root:root /home/user1/bin/chown
   53  sudo setcap cap_chown+ep /home/user1/bin/chown
   54  sudo getcap /home/user1/bin/chown
   55  {   echo "=== до: владелец root ===";   ls -l /tmp/rootfile;   echo "=== getcap ===";   sudo getcap /home/user1/bin/chown;   echo "=== смена владельца от user1 ===";   sudo -u user1 /home/user1/bin/chown user1 /tmp/rootfile;   echo "exit=$?";   echo "=== после: владелец user1 ===";   ls -l /tmp/rootfile; } > ~/mephi-repo/cap-demo.out
   56  cat ~/mephi-repo/cap-demo.out
